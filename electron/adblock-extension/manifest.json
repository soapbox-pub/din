{
  "manifest_version": 2,
  "name": "Din Ad Blocker",
  "version": "1.0.0",
  "description": "Blocks ads and trackers in Din's web browser.",
  "key": "",
  "background": {
    "scripts": ["engine.js", "background.js"],
    "persistent": true
  },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"]
}
