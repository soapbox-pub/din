{
  "name": "Games",
  "description": "Play the games in your games folder, full screen, with a controller.",
  "icons": [{ "src": "/icons/apps/games.png", "sizes": "512x512", "type": "image/png" }],
  "start_url": "/",
  "launch_handler": { "client_mode": "focus-existing" },
  "din": {
    "permissions": ["games"],
    "folders": ["~/roms"],
    "fetch": ["thumbnails.libretro.com"],
    "window": { "size": { "width": 1200, "height": 800 }, "frame": "custom" },
    "keywords": ["games", "emulator", "RetroArch", "EmulationStation", "ROMs", "Nintendo", "SNES", "Game Boy", "N64", "Sega", "PlayStation", "controller", "gamepad", "arcade", "retro"]
  }
}
