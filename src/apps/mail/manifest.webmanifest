{
  "name": "Mail",
  "description": "Email from iCloud, Gmail, Outlook and any IMAP account, the way Apple Mail does it.",
  "icons": [{ "src": "/icons/apps/mail.png", "sizes": "512x512", "type": "image/png" }],
  "start_url": "/",
  "launch_handler": { "client_mode": "navigate-new" },
  "shortcuts": [
    { "name": "New Message", "url": "/?new", "din": { "id": "compose" } }
  ],
  "share_target": {
    "action": "/?new",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "subject",
      "text": "text",
      "url": "url",
      "files": [{ "name": "attachments", "accept": ["*/*"] }]
    }
  },
  "din": {
    "permissions": ["mail"],
    "window": { "size": { "width": 1180, "height": 760 }, "frame": "custom" },
    "keywords": ["email", "e-mail", "inbox", "imap", "smtp", "gmail", "icloud", "outlook", "thunderbird", "letters"]
  }
}
