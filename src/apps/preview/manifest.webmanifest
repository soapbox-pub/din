{
  "name": "Preview",
  "description": "A window for one file opened from Files: a picture, a video, a song, a PDF, a 3D model, an archive's contents, a cursor theme, or text to read and edit.",
  "icons": [
    {
      "src": "/icons/apps/preview.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "/",
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "din": {
    "permissions": [
      "cursor",
      "file-folders",
      "wallpaper"
    ],
    "window": {
      "size": {
        "width": 820,
        "height": 600
      },
      "frame": "standard"
    },
    "hidden": true,
    "keywords": [
      "viewer",
      "quick look",
      "pictures",
      "photos",
      "images",
      "pdf",
      "3d",
      "models"
    ]
  }
}
