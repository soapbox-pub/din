{
  "name": "Media Player",
  "description": "Music and video, Windows Media Player style with Winamp's soul: a library of your Music and Videos folders, internet radio, the equalizer, visualizations, and Winamp and Windows Media Player skins.",
  "icons": [
    {
      "src": "/icons/apps/media-player.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Library",
      "url": "/?show=library",
      "din": {
        "id": "library"
      }
    },
    {
      "name": "Mini Player",
      "url": "/?show=mini",
      "din": {
        "id": "mini"
      }
    },
    {
      "name": "Use Din's Own Skin",
      "url": "/?show=din-skin",
      "din": {
        "id": "din-skin"
      }
    }
  ],
  "din": {
    "permissions": [
      "file-folders"
    ],
    "folders": [
      "~/Music",
      "~/Videos",
      "~/.local/share/din/skins",
      "~/.local/share/din/media-library"
    ],
    "window": {
      "size": {
        "width": 1040,
        "height": 680
      },
      "frame": "standard"
    },
    "keywords": [
      "music player",
      "video player",
      "windows media player",
      "wmp",
      "winamp",
      "itunes",
      "vlc",
      "music",
      "mp3",
      "audio",
      "songs",
      "playlist",
      "radio",
      "equalizer",
      "visualization",
      "skins",
      "video",
      "movies",
      "media"
    ],
    "migrateStorage": [
      "din:media-player:*"
    ],
    "migrateFiles": {
      "~/.local/share/din/media-library.json": "~/.local/share/din/media-library/library.json"
    }
  }
}
