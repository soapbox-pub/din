{
  "name": "Virtual Machines",
  "description": "Run Windows, Linux and other operating systems in windows of their own, with snapshots to go back to.",
  "icons": [{ "src": "/icons/apps/virtual-machines.png", "sizes": "512x512", "type": "image/png" }],
  "start_url": "/",
  "launch_handler": { "client_mode": "focus-existing" },
  "din": {
    "permissions": ["vms"],
    "folders": ["~/VMs"],
    "window": { "size": { "width": 1200, "height": 800 }, "frame": "custom" },
    "keywords": ["VM", "virtual machine", "VirtualBox", "VMware", "Parallels", "QEMU", "KVM", "Boxes", "emulator", "Windows", "Linux", "ISO", "hypervisor", "snapshot"]
  }
}
