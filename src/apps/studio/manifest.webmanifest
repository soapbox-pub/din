{
  "name": "Studio",
  "description": "Record yourself and your screen, for the Assistant to edit into YouTube videos, TikToks and Shorts, or go live on YouTube, Twitch and Kick.",
  "icons": [
    {
      "src": "/icons/apps/studio.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "/",
  "background_color": "#0a0a0a",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "din://assistant/manifest.webmanifest"
    }
  ],
  "din": {
    "permissions": [
      "capture"
    ],
    "folders": [
      "~/Videos/Studio"
    ],
    "window": {
      "size": {
        "width": 1180,
        "height": 780
      },
      "frame": "custom"
    },
    "keywords": [
      "obs",
      "loom",
      "screen recorder",
      "webcam",
      "camera",
      "record",
      "video",
      "youtube",
      "tiktok",
      "shorts",
      "reels",
      "stream",
      "livestream",
      "live",
      "twitch",
      "kick",
      "rtmp",
      "podcast"
    ]
  }
}
