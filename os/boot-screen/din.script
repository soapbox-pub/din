# Din's boot and unlock screen, for Plymouth (see os/boot-screen.nix).
#
# It looks like Din's old login screen: the wallpaper, dimmed, a large clock
# and the date, a password field, and Din's logo at the foot. Otherwise
# there's only the background, the footer, and a progress bar above it. Once
# root is mounted the lock screen fades away and the logo and bar stay,
# until Din's own boot veil, which draws them in the same place
# (src/components/desktop/BootVeil.tsx), takes over.
#
# What it can't know by itself arrives through files and messages from the
# initrd (os/boot-screen.nix): the wallpaper is a file in ImageDir that may
# only show up after this starts, and the time comes as display-message
# lines "din-clock:<time>|<date>", since Plymouth scripts have no clock.
#
# Plymouth draws every screen from one canvas, the size of the largest screen,
# with each screen a window centered on it. What's centered on the canvas is
# centered on every screen, but only the smallest screen's area is on all of
# them, so what sits at an edge (the logo, the bar) goes at the smallest's
# edge, and sizes follow the smallest's height. The screens change while this
# runs: Plymouth starts on the firmware's framebuffer, which may be the
# laptop's own screen alone, and a moment later the GPU's driver replaces it
# with every screen at its own size. So refresh measures them every frame and
# lays everything out again when they change (layout, below).

Window.SetBackgroundTopColor(0.043, 0.059, 0.078);
Window.SetBackgroundBottomColor(0.043, 0.059, 0.078);

# The canvas (x, y, w, h) and the smallest screen's size on it (inner_w,
# inner_h), which is centered on it like every screen.
fun measure()
{
  local.m.x = Window.GetX();
  m.y = Window.GetY();
  m.w = Window.GetWidth();
  m.h = Window.GetHeight();
  m.inner_w = m.w;
  m.inner_h = m.h;
  for (i = 0; Window.GetWidth(i); i++)
  {
    m.inner_w = Math.Min(m.inner_w, Window.GetWidth(i));
    m.inner_h = Math.Min(m.inner_h, Window.GetHeight(i));
  }
  return m;
}

screen = measure();
# Sizes are designed for 1080 lines and follow the smallest screen's height.
scale = Math.Max(screen.inner_h / 1080, 0.5);

fun px(size)
{
  return Math.Int(size * scale);
}

fun font(weight, size)
{
  return "Inter " + weight + " " + px(size);
}

fun text(string, alpha, weight, size)
{
  return Image.Text(string, 1, 1, 1, alpha, font(weight, size));
}

# A sprite that eases its opacity toward a target, a little each frame.
fun fader(sprite, z)
{
  local.f.sprite = sprite;
  f.sprite.SetZ(z);
  f.sprite.SetOpacity(0);
  f.opacity = 0;
  f.target = 0;
  return f;
}

fun ease(f)
{
  if (f.instant)
    f.opacity = f.target;
  f.opacity += (f.target - f.opacity) * 0.12;
  if (Math.Abs(f.target - f.opacity) < 0.005)
    f.opacity = f.target;
  f.sprite.SetOpacity(f.opacity);
  return f;
}

fun center(sprite, image, y)
{
  sprite.SetImage(image);
  sprite.SetX(screen.x + Math.Int((screen.w - image.GetWidth()) / 2));
  sprite.SetY(screen.y + y);
}

black = Image("black.png");

#------------------------------------ Wallpaper -------------------------------

wallpaper = fader(Sprite(), -100);
dim = fader(Sprite(), -90);
# These two cover the screen, and Plymouth blends every pixel of a sprite whose
# opacity is changing on the CPU, under a second a frame or worse on a screen of
# 5 million pixels. Easing counts frames, so that fade would last half a minute
# and keep the keyboard waiting. They change at once; the small sprites fade.
wallpaper.instant = 1;
dim.instant = 1;
wallpaper_tries = 0;

# Scaled to cover the canvas, centered, as Din draws it.
fun place_wallpaper()
{
  image = global.wallpaper_image;
  factor = Math.Max(screen.w / image.GetWidth(), screen.h / image.GetHeight());
  width = Math.Int(image.GetWidth() * factor + 0.999);
  height = Math.Int(image.GetHeight() * factor + 0.999);
  wallpaper.sprite.SetImage(image.Scale(width, height));
  wallpaper.sprite.SetX(screen.x + Math.Int((screen.w - width) / 2));
  wallpaper.sprite.SetY(screen.y + Math.Int((screen.h - height) / 2));
}

fun load_wallpaper()
{
  image = Image("wallpaper.png");
  if (!image)
    return 0;
  global.wallpaper_image = image;
  place_wallpaper();
  return 1;
}

#------------------------------------ Lock screen -----------------------------

clock = fader(Sprite(), 10);
date = fader(Sprite(), 10);
field = fader(Sprite(), 10);
entry = fader(Sprite(), 11);
caption = fader(Sprite(), 10);
fingerprint = fader(Sprite(), 10);
footer = fader(Sprite(), 10);

field_image = Image("field.png");
logo_image = Image("logo.png");
footer.target = 0.85;

# The bar: Plymouth's estimate of how far booting has got, from how long the
# last boots took. It fills to BAR_SHARE by the time Din starts, and Din's
# veil goes on from there.
BAR_SHARE = 0.7;
track_image = Image("bar-track.png");
track = fader(Sprite(), 10);
fill = fader(Sprite(), 11);
fill_image = Image("bar-fill.png");
shown = 0;
progress = 0;
fill_width = 0;

fun boot_progress(duration, value)
{
  value = value * BAR_SHARE;
  if (value > global.progress)
    global.progress = value;
}

asked = 0;
mounted = 0;
locked = 0;

fun show_lock()
{
  global.locked = 1;
  clock.target = 1;
  date.target = 1;
  field.target = 1;
  entry.target = 1;
  caption.target = 1;
  dim.target = 0.3;
}

# The caret, which blinks in the field while it waits for the password: before
# the placeholder when the field is empty, after the dots once typing starts.
caret_image = Image("cursor.png");
caret = Sprite();
caret.SetZ(12);
caret.SetOpacity(0);
caret_shown = 0;
caret_frame = 0;
# Refresh runs 50 times a second: half a second on, half a second off.
CARET_PERIOD = 50;

CARET_NONE = 0;
CARET_BEFORE = 1;
CARET_AFTER = 2;

# What the field, the caption and the clock show, kept so that layout can draw
# them again at a new size.
entry_set = 0;
caption_set = 0;
clock_size = 0;
date_set = 0;

fun set_entry(string, alpha, size, caret_at)
{
  global.entry_set = 1;
  global.entry_text = string;
  global.entry_alpha = alpha;
  global.entry_size = size;
  global.entry_caret = caret_at;
  image = text(string, alpha, "Regular", size);
  center(entry.sprite, image, field_y + Math.Int((px(48) - image.GetHeight()) / 2));
  left = Math.Int((screen.w - image.GetWidth()) / 2);
  if (caret_at == CARET_BEFORE)
    caret.SetX(screen.x + left - px(6) - caret_w);
  else
    caret.SetX(screen.x + left + image.GetWidth() + px(4));
  caret.SetY(screen.y + field_y + Math.Int((px(48) - caret_h) / 2));
  if (caret_at == CARET_NONE)
    global.caret_shown = 0;
  else
    global.caret_shown = 1;
  # Solid while typing, as in any text field; the blink starts again after.
  global.caret_frame = 0;
}

fun set_caption(string)
{
  global.caption_set = 1;
  global.caption_text = string;
  center(caption.sprite, text(string, 0.55, "Regular", 13), caption_y);
}

fun display_password(prompt, bullets)
{
  if (global.asked == 0 || global.entered)
  {
    if (global.asked > 0)
      set_caption("That password didn't work. Try again.");
    else
      set_caption("Enter your password to unlock this computer.");
    global.asked++;
    global.entered = 0;
  }
  if (bullets == 0)
  {
    set_entry("Password", 0.5, 15, CARET_BEFORE);
  }
  else
  {
    dots = "";
    for (i = 0; i < bullets && i < 24; i++)
      dots += "•";
    set_entry(dots, 1, 20, CARET_AFTER);
  }
  show_lock();
}

# Called once the password is in, while the disk checks it.
fun display_normal()
{
  if (global.asked > 0 && !global.entered)
  {
    global.entered = 1;
    set_entry("Unlocking…", 0.7, 15, CARET_NONE);
  }
}

fun display_message(message)
{
  message = String(message);
  if (message == "din-fingerprint-on")
  {
    fingerprint.target = 1;
    return;
  }
  if (message == "din-fingerprint-off")
  {
    fingerprint.target = 0;
    return;
  }
  # The whole screen drawn again, as the lock screen asks after the computer
  # wakes (os/din-lock.py): setting a sprite's image redraws all it covers,
  # at any opacity, and the dimming covers the screen.
  if (message == "din-redraw")
  {
    dim.sprite.SetImage(dim_image);
    return;
  }
  # What the computer is doing, in the clock's place: "Erasing…" while
  # os/din-erase.sh erases it.
  if (message.SubString(0, 11) == "din-status:")
  {
    set_clock(message.SubString(11, message.Length()), 48, 24);
    clock.target = 1;
    return;
  }
  if (message.SubString(0, 10) != "din-clock:")
    return;
  rest = String(message.SubString(10, message.Length()));
  bar = 0;
  while (bar < rest.Length() && rest.CharAt(bar) != "|")
    bar++;
  set_clock(rest.SubString(0, bar), 72, 0);
  global.date_set = 1;
  global.date_text = rest.SubString(bar + 1, rest.Length());
  center(date.sprite, text(date_text, 0.7, "Regular", 16), date_y);
}

# The clock's line, or what the computer is doing in its place, a little lower.
fun set_clock(string, size, offset)
{
  global.clock_text = string;
  global.clock_size = size;
  global.clock_offset = offset;
  center(clock.sprite, text(string, 1, "Semi-Bold", size), clock_y + px(offset));
}

#------------------------------------ Layout ----------------------------------

# Places and sizes everything for the screens there are now (see the top).
fun layout()
{
  global.screen = measure();
  global.scale = Math.Max(screen.inner_h / 1080, 0.5);
  # The smallest screen's bottom edge, on the canvas.
  bottom = Math.Int((screen.h + screen.inner_h) / 2);

  global.dim_image = black.Scale(screen.w, screen.h);
  dim.sprite.SetImage(dim_image);
  dim.sprite.SetPosition(screen.x, screen.y, -90);
  if (wallpaper.loaded)
    place_wallpaper();

  global.clock_y = Math.Int(screen.h * 0.5) - px(190);
  global.date_y = clock_y + px(124);
  global.field_y = date_y + px(104);
  global.caption_y = field_y + px(64);
  center(fingerprint.sprite, text("Or use your fingerprint reader.", 0.7, "Regular", 13), caption_y + px(24));
  if (field_image)
    center(field.sprite, field_image.Scale(px(320), px(48)), field_y);

  global.logo_h = px(28);
  if (logo_image)
  {
    logo_w = Math.Int(logo_image.GetWidth() * logo_h / logo_image.GetHeight());
    center(footer.sprite, logo_image.Scale(logo_w, logo_h), bottom - px(40) - logo_h);
  }

  global.bar_w = px(160);
  global.bar_h = Math.Max(px(4), 2);
  bar_y = bottom - px(40) - logo_h - px(24) - bar_h;
  bar_x = Math.Int((screen.w - bar_w) / 2);
  track.sprite.SetImage(track_image.Scale(bar_w, bar_h));
  track.sprite.SetPosition(screen.x + bar_x, screen.y + bar_y, 10);
  fill.sprite.SetPosition(screen.x + bar_x, screen.y + bar_y, 11);
  # refresh scales the fill again for the new width.
  global.fill_width = 0;

  global.caret_w = Math.Max(px(2), 1);
  global.caret_h = px(22);
  caret.SetImage(caret_image.Scale(caret_w, caret_h));

  if (clock_size)
    set_clock(clock_text, clock_size, clock_offset);
  if (date_set)
    center(date.sprite, text(date_text, 0.7, "Regular", 16), date_y);
  if (caption_set)
    set_caption(caption_text);
  if (entry_set)
  {
    # set_entry shows the caret solid again, as after a key; keep its blink.
    frame = caret_frame;
    set_entry(entry_text, entry_alpha, entry_size, entry_caret);
    global.caret_frame = frame;
  }
}

layout();

#------------------------------------ Unlocked --------------------------------

fun root_mounted()
{
  global.mounted = 1;
  global.locked = 0;
  global.caret_shown = 0;
  clock.target = 0;
  date.target = 0;
  field.target = 0;
  entry.target = 0;
  caption.target = 0;
  fingerprint.target = 0;
  dim.target = 0;
  wallpaper.target = 0;
}

#------------------------------------ Every frame -----------------------------

capslock = 0;

fun refresh()
{
  m = measure();
  if (m.w != screen.w || m.h != screen.h || m.inner_w != screen.inner_w || m.inner_h != screen.inner_h)
    layout();

  # The wallpaper is copied off the boot partition once that turns up, often
  # after this script starts; look for it for the first ten seconds.
  if (!wallpaper.loaded && wallpaper_tries < 500)
  {
    if (Math.Int(wallpaper_tries / 25) * 25 == wallpaper_tries)
      wallpaper.loaded = load_wallpaper();
    wallpaper_tries++;
  }
  if (wallpaper.loaded && locked)
    wallpaper.target = 1;

  # The bar has nothing to say while the password is asked for.
  if (locked)
  {
    track.target = 0;
    fill.target = 0;
  }
  else
  {
    track.target = 0.85;
    fill.target = 0.85;
  }
  # Eased toward the estimate, so it moves smoothly and never goes back.
  global.shown += (progress - shown) * 0.08;
  width = Math.Int(bar_w * shown);
  # Only when it grows: scaling it is work on the CPU, and setting an image
  # redraws what it covers, even while the bar is hidden.
  if (width >= 1 && width != fill_width)
  {
    fill.sprite.SetImage(fill_image.Scale(width, bar_h));
    global.fill_width = width;
  }

  if (asked > 0 && !entered && Plymouth.GetCapslockState() != capslock)
  {
    global.capslock = Plymouth.GetCapslockState();
    if (capslock)
      set_caption("Caps Lock is on.");
    else
      set_caption("Enter your password to unlock this computer.");
  }

  global.wallpaper = ease(wallpaper);
  global.dim = ease(dim);
  global.clock = ease(clock);
  global.date = ease(date);
  global.field = ease(field);
  global.entry = ease(entry);
  global.caption = ease(caption);
  global.fingerprint = ease(fingerprint);
  global.footer = ease(footer);
  global.track = ease(track);
  global.fill = ease(fill);

  global.caret_frame++;
  if (caret_frame >= CARET_PERIOD)
    global.caret_frame = 0;
  if (caret_shown && locked && caret_frame < CARET_PERIOD / 2)
    caret.SetOpacity(entry.opacity * 0.9);
  else
    caret.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetRootMountedFunction(root_mounted);
Plymouth.SetBootProgressFunction(boot_progress);
