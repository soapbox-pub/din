diff --git a/cage.c b/cage.c
index 3e3df0e..03faed4 100644
--- a/cage.c
+++ b/cage.c
@@ -377,6 +377,14 @@ main(int argc, char *argv[])
 
 	server.scene_output_layout = wlr_scene_attach_output_layout(server.scene, server.output_layout);
 
+	/* DinOS: the boot screen's background, under every window, so the screen
+	 * doesn't turn black between the boot screen and Din. */
+	const float background[4] = {0.043f, 0.059f, 0.078f, 1.0f};
+	struct wlr_scene_rect *backdrop = wlr_scene_rect_create(&server.scene->tree, 65536, 65536, background);
+	if (backdrop) {
+		wlr_scene_node_set_position(&backdrop->node, -32768, -32768);
+	}
+
 	struct wlr_compositor *compositor = wlr_compositor_create(server.wl_display, 6, server.renderer);
 	if (!compositor) {
 		wlr_log(WLR_ERROR, "Unable to create the wlroots compositor");
diff --git a/seat.c b/seat.c
index a4ed476..2932c67 100644
--- a/seat.c
+++ b/seat.c
@@ -126,8 +126,9 @@ update_capabilities(struct cg_seat *seat)
 	}
 	wlr_seat_set_capabilities(seat->seat, caps);
 
-	/* Hide cursor if the seat doesn't have pointer capability. */
-	if ((caps & WL_SEAT_CAPABILITY_POINTER) == 0) {
+	/* Hide cursor if the seat doesn't have pointer capability, and (DinOS)
+	 * until there's a window to point at. */
+	if ((caps & WL_SEAT_CAPABILITY_POINTER) == 0 || wl_list_empty(&seat->server->views)) {
 		wlr_cursor_unset_image(seat->cursor);
 	} else {
 		wlr_cursor_set_xcursor(seat->cursor, seat->xcursor_manager, DEFAULT_XCURSOR);
diff --git a/view.c b/view.c
