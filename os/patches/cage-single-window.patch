+bool
 view_map(struct cg_view *view, struct wlr_surface *surface)
 {
+	/* DinOS: the first window is Din, the whole desktop, and the only one
+	 * shown. Any other would cover it fullscreen and take all the input,
+	 * with no way back to Din, so it's asked to close and never shown. */
+	if (!wl_list_empty(&view->server->views)) {
+		char *title = view_get_title(view);
+		wlr_log(WLR_INFO, "Refusing a second window (\"%s\")", title ? title : "");
+		free(title);
+		view->impl->close(view);
+		return false;
+	}
+
