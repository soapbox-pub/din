diff --git a/output.c b/output.c
index 9f2a708..44ddd59 100644
--- a/output.c
+++ b/output.c
@@ -12,7 +12,9 @@
 #include "config.h"
 
 #include <assert.h>
+#include <stdint.h>
 #include <stdlib.h>
+#include <time.h>
 #include <unistd.h>
 #include <wayland-server-core.h>
 #include <wlr/backend.h>
@@ -132,6 +134,59 @@ output_disable(struct cg_output *output)
 	output_layout_remove(output);
 }
 
+/*
+ * Milliseconds before a refresh to commit the next frame (like sway's
+ * max_render_time), from CAGE_MAX_RENDER_TIME; 0, the default, commits as
+ * soon as the last frame is on screen. Committing then means a client
+ * buffer that arrives a moment later waits a whole refresh to be queued;
+ * committing just before the refresh lets it make that one instead. With
+ * the client's buffer scanned out directly, a commit takes well under a
+ * millisecond, so a few are plenty.
+ */
+static int
+max_render_time(void)
+{
+	static int value = -1;
+	if (value < 0) {
+		const char *env = getenv("CAGE_MAX_RENDER_TIME");
+		value = env ? atoi(env) : 0;
+		if (value < 0) {
+			value = 0;
+		}
+	}
+	return value;
+}
+
+static int
+output_repaint(void *data)
+{
+	struct cg_output *output = data;
+	output->repaint_pending = false;
+
+	if (!output->wlr_output->enabled || !output->scene_output) {
+		return 0;
+	}
+
+	wlr_scene_output_commit(output->scene_output, NULL);
+	return 0;
+}
+
+/* Whole milliseconds until the refresh after the last one, or 0 if unknown or past. */
+static int
+ms_until_refresh(struct cg_output *output)
+{
+	if (output->refresh_nsec <= 0 || output->last_presentation.tv_sec == 0) {
+		return 0;
+	}
+
+	struct timespec now = {0};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	int64_t next = (int64_t) output->last_presentation.tv_sec * 1000000000 + output->last_presentation.tv_nsec +
+		       output->refresh_nsec;
+	int64_t until = next - ((int64_t) now.tv_sec * 1000000000 + now.tv_nsec);
+	return until > 0 ? (int) (until / 1000000) : 0;
+}
+
 static void
 handle_output_frame(struct wl_listener *listener, void *data)
 {
@@ -141,13 +196,39 @@ handle_output_frame(struct wl_listener *listener, void *data)
 		return;
 	}
 
-	wlr_scene_output_commit(output->scene_output, NULL);
+	/* A client committed while the commit waits for its deadline: it's
+	 * in that commit, and hears frame done after the refresh it makes. */
+	if (output->repaint_pending) {
+		return;
+	}
+
+	int delay = max_render_time() > 0 ? ms_until_refresh(output) - max_render_time() : 0;
+	if (delay < 1 || !output->repaint_timer) {
+		output_repaint(output);
+	} else {
+		output->repaint_pending = true;
+		wl_event_source_timer_update(output->repaint_timer, delay);
+	}
 
+	/* Clients start their next frame now, so it's ready by the deadline. */
 	struct timespec now = {0};
 	clock_gettime(CLOCK_MONOTONIC, &now);
 	wlr_scene_output_send_frame_done(output->scene_output, &now);
 }
 
+static void
+handle_output_present(struct wl_listener *listener, void *data)
+{
+	struct cg_output *output = wl_container_of(listener, output, present);
+	struct wlr_output_event_present *event = data;
+
+	if (!event->presented) {
+		return;
+	}
+	output->last_presentation = event->when;
+	output->refresh_nsec = event->refresh;
+}
+
 static void
 handle_output_commit(struct wl_listener *listener, void *data)
 {
@@ -209,8 +290,13 @@ output_destroy(struct cg_output *output)
 	wl_list_remove(&output->commit.link);
 	wl_list_remove(&output->request_state.link);
 	wl_list_remove(&output->frame.link);
+	wl_list_remove(&output->present.link);
 	wl_list_remove(&output->link);
 
+	if (output->repaint_timer) {
+		wl_event_source_remove(output->repaint_timer);
+	}
+
 	output_layout_remove(output);
 
 	free(output);
@@ -272,6 +358,10 @@ handle_new_output(struct wl_listener *listener, void *data)
 	wl_signal_add(&wlr_output->events.destroy, &output->destroy);
 	output->frame.notify = handle_output_frame;
 	wl_signal_add(&wlr_output->events.frame, &output->frame);
+	output->present.notify = handle_output_present;
+	wl_signal_add(&wlr_output->events.present, &output->present);
+	output->repaint_timer =
+		wl_event_loop_add_timer(wl_display_get_event_loop(server->wl_display), output_repaint, output);
 
 	output->scene_output = wlr_scene_output_create(server->scene, wlr_output);
 	if (!output->scene_output) {
diff --git a/output.h b/output.h
index fa72545..e898066 100644
--- a/output.h
+++ b/output.h
@@ -16,6 +16,14 @@ struct cg_output {
 	struct wl_listener request_state;
 	struct wl_listener destroy;
 	struct wl_listener frame;
+	struct wl_listener present;
+
+	/* Commits wait for this, just before the next refresh (CAGE_MAX_RENDER_TIME). */
+	struct wl_event_source *repaint_timer;
+	bool repaint_pending;
+	/* When the last frame reached the screen, and the refresh interval (0: unknown). */
+	struct timespec last_presentation;
+	int refresh_nsec;
 
 	struct wl_list link; // cg_server::outputs
 };
