{
  "name": "din",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "scripts/dev-electron.sh",
    "dev:browser": "npm i --silent && vite",
    "build:adblock": "node scripts/build-adblock-engine.mjs",
    "build:cursors": "node scripts/build-cursor-converter.mjs",
    "build:native": "cargo build --release --manifest-path native/din-compositor/Cargo.toml && cargo build --release --manifest-path native/din-fd/Cargo.toml",
    "build": "npm i --silent && vite build -l error && node scripts/build-electron.mjs && node scripts/build-cursor-converter.mjs && cp dist/index.html dist/404.html && echo 'Project built successfully!'",
    "build:profile": "VITE_PROFILE=1 npm run build",
    "perf:profile": "node scripts/perf-profile.mjs",
    "test": "npm i --silent && tsc --noEmit && tsc -p tsconfig.electron.json && eslint --cache && vitest run --reporter=dot --silent && vite build -l error && node scripts/build-electron.mjs && node scripts/build-cursor-converter.mjs && cp dist/index.html dist/404.html && echo 'All tests passed!'",
    "os:build": "nix build ./os#image",
    "os:run": "nix build ./os#vm && ./result/bin/run-dinos-vm",
    "os:release": "scripts/dinos-release.sh",
    "os:clean": "rm -f result dinos.qcow2"
  },
