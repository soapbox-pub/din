{
  "name": "din",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "scripts/dev-electron.sh",
    "dev:browser": "npm i --silent && vite",
    "build:adblock": "node scripts/build-adblock-engine.mjs",
    "build:native": "cargo build --release --manifest-path native/din-compositor/Cargo.toml && cargo build --release --manifest-path native/din-fd/Cargo.toml",
    "build": "npm i --silent && vite build -l error && cp dist/index.html dist/404.html && echo 'Project built successfully!'",
    "build:profile": "VITE_PROFILE=1 npm run build",
    "perf:profile": "node scripts/perf-profile.mjs",
    "test": "npm i --silent && tsc --noEmit && tsc -p tsconfig.electron.json && eslint --cache && vitest run --reporter=dot --silent && vite build -l error && cp dist/index.html dist/404.html && echo 'All tests passed!'",
    "os:build": "nix build ./os#image",
    "os:run": "nix build ./os#vm && ./result/bin/run-dinos-vm",
    "os:release": "scripts/dinos-release.sh",
    "os:clean": "rm -f result dinos.qcow2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron-preload": "^2.20.1",
    "@nostrify/nostrify": "^0.52.2",
    "@nostrify/react": "^0.6.2",
    "@radix-ui/react-toast": "^1.2.1",
    "@tanstack/react-query": "^5.100.5",
    "@unhead/react": "^3.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-chrome-context-menu": "^1.1.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.11.0",
    "nostr-tools": "^2.23.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tldts-experimental": "^7.4.19",
    "tw-animate-css": "^1.2.0",
    "unhead": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.59.0",
    "@html-eslint/parser": "^0.59.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
